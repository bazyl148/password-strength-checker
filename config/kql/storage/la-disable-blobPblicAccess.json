{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "Microsoft_Sentinel_incident": {
                "type": "ApiConnectionWebhook",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                        }
                    },
                    "body": {
                        "callback_url": "@{listCallbackUrl()}"
                    },
                    "path": "/incident-creation"
                }
            }
        },
        "actions": {
            "Initialize_variables": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "listOfExposedSA",
                            "type": "array"
                        }
                    ]
                },
                "runAfter": {}
            },
            "Get_account_details": {
                "type": "Http",
                "inputs": {
                    "uri": "https://management.azure.com@{triggerBody()?['object']?['properties']?['relatedEntities']?[0]?['properties']?['resourceId']}?api-version=2025-06-01",
                    "method": "GET",
                    "headers": {
                        "Content-Type": "application/json"
                    },
                    "authentication": {
                        "type": "ManagedServiceIdentity"
                    }
                },
                "runAfter": {
                    "Initialize_variables": [
                        "Succeeded"
                    ]
                },
                "runtimeConfiguration": {
                    "contentTransfer": {
                        "transferMode": "Chunked"
                    }
                }
            },
            "Parse_JSON": {
                "type": "ParseJson",
                "inputs": {
                    "content": "@body('Get_account_details')",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "sku": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "tier": {
                                        "type": "string"
                                    }
                                }
                            },
                            "kind": {
                                "type": "string"
                            },
                            "id": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "type": {
                                "type": "string"
                            },
                            "location": {
                                "type": "string"
                            },
                            "tags": {
                                "type": "object",
                                "properties": {}
                            },
                            "properties": {
                                "type": "object",
                                "properties": {
                                    "allowCrossTenantDelegationSas": {
                                        "type": "boolean"
                                    },
                                    "dualStackEndpointPreference": {
                                        "type": "object",
                                        "properties": {
                                            "defaultDualStackEndpoints": {
                                                "type": "boolean"
                                            },
                                            "publishIpv4Endpoint": {
                                                "type": "boolean"
                                            },
                                            "publishIpv6Endpoint": {
                                                "type": "boolean"
                                            }
                                        }
                                    },
                                    "dnsEndpointType": {
                                        "type": "string"
                                    },
                                    "defaultToOAuthAuthentication": {
                                        "type": "boolean"
                                    },
                                    "publicNetworkAccess": {
                                        "type": "string"
                                    },
                                    "keyCreationTime": {
                                        "type": "object",
                                        "properties": {
                                            "key1": {
                                                "type": "string"
                                            },
                                            "key2": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "allowCrossTenantReplication": {
                                        "type": "boolean"
                                    },
                                    "privateEndpointConnections": {
                                        "type": "array"
                                    },
                                    "minimumTlsVersion": {
                                        "type": "string"
                                    },
                                    "allowBlobPublicAccess": {
                                        "type": "boolean"
                                    },
                                    "allowSharedKeyAccess": {
                                        "type": "boolean"
                                    },
                                    "networkAcls": {
                                        "type": "object",
                                        "properties": {
                                            "ipv6Rules": {
                                                "type": "array"
                                            },
                                            "resourceAccessRules": {
                                                "type": "array"
                                            },
                                            "bypass": {
                                                "type": "string"
                                            },
                                            "virtualNetworkRules": {
                                                "type": "array"
                                            },
                                            "ipRules": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "value": {
                                                            "type": "string"
                                                        },
                                                        "action": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "required": [
                                                        "value",
                                                        "action"
                                                    ]
                                                }
                                            },
                                            "defaultAction": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "supportsHttpsTrafficOnly": {
                                        "type": "boolean"
                                    },
                                    "encryption": {
                                        "type": "object",
                                        "properties": {
                                            "requireInfrastructureEncryption": {
                                                "type": "boolean"
                                            },
                                            "services": {
                                                "type": "object",
                                                "properties": {
                                                    "file": {
                                                        "type": "object",
                                                        "properties": {
                                                            "keyType": {
                                                                "type": "string"
                                                            },
                                                            "enabled": {
                                                                "type": "boolean"
                                                            },
                                                            "lastEnabledTime": {
                                                                "type": "string"
                                                            }
                                                        }
                                                    },
                                                    "blob": {
                                                        "type": "object",
                                                        "properties": {
                                                            "keyType": {
                                                                "type": "string"
                                                            },
                                                            "enabled": {
                                                                "type": "boolean"
                                                            },
                                                            "lastEnabledTime": {
                                                                "type": "string"
                                                            }
                                                        }
                                                    }
                                                }
                                            },
                                            "keySource": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "provisioningState": {
                                        "type": "string"
                                    },
                                    "creationTime": {
                                        "type": "string"
                                    },
                                    "primaryEndpoints": {
                                        "type": "object",
                                        "properties": {
                                            "dfs": {
                                                "type": "string"
                                            },
                                            "web": {
                                                "type": "string"
                                            },
                                            "blob": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "primaryLocation": {
                                        "type": "string"
                                    },
                                    "statusOfPrimary": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "runAfter": {
                    "Get_account_details": [
                        "Succeeded"
                    ]
                }
            },
            "Check_if_still_exposed": {
                "type": "If",
                "expression": {
                    "and": [
                        {
                            "equals": [
                                "@body('Parse_JSON')?['properties']?['publicNetworkAccess']",
                                "Enabled"
                            ]
                        },
                        {
                            "equals": [
                                "@body('Parse_JSON')?['properties']?['allowBlobPublicAccess']",
                                true
                            ]
                        },
                        {
                            "equals": [
                                "",
                                ""
                            ]
                        }
                    ]
                },
                "actions": {
                    "Disable_allowBlobPublicAccess": {
                        "type": "Http",
                        "inputs": {
                            "uri": "https://management.azure.com@{triggerBody()?['object']?['properties']?['relatedEntities']?[0]?['properties']?['resourceId']}?api-version=2025-06-01",
                            "method": "PATCH",
                            "headers": {
                                "Content-Type": "application/json"
                            },
                            "body": {
                                "properties": {
                                    "allowBlobPublicAccess": false
                                }
                            },
                            "authentication": {
                                "type": "ManagedServiceIdentity"
                            }
                        },
                        "runtimeConfiguration": {
                            "contentTransfer": {
                                "transferMode": "Chunked"
                            }
                        }
                    },
                    "Append_to_array_variable": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                            "name": "listOfExposedSA",
                            "value": "@body('Parse_JSON')?['name']"
                        },
                        "runAfter": {
                            "Disable_allowBlobPublicAccess": [
                                "Succeeded"
                            ]
                        }
                    }
                },
                "else": {
                    "actions": {}
                },
                "runAfter": {
                    "Parse_JSON": [
                        "Succeeded"
                    ]
                }
            }
        },
        "outputs": {},
        "parameters": {
            "$connections": {
                "type": "Object",
                "defaultValue": {}
            }
        }
    },
    "parameters": {
        "$connections": {
            "type": "Object",
            "value": {
                "azuresentinel": {
                    "id": "/subscriptions/f2228eff-60ab-4050-b43e-907a256852b3/providers/Microsoft.Web/locations/canadacentral/managedApis/azuresentinel",
                    "connectionId": "/subscriptions/f2228eff-60ab-4050-b43e-907a256852b3/resourceGroups/rg-demo/providers/Microsoft.Web/connections/azuresentinel-la-remediate-test",
                    "connectionName": "azuresentinel-la-remediate-test",
                    "connectionProperties": {
                        "authentication": {
                            "type": "ManagedServiceIdentity"
                        }
                    }
                }
            }
        }
    }
}
